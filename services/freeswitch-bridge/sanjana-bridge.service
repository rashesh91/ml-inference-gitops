[Unit]
Description=Sanjana FreeSWITCH AI Bridge (sub-500ms)
After=freeswitch.service network-online.target
Requires=freeswitch.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=root
WorkingDirectory=/opt/sanjana-bridge
ExecStart=/opt/sanjana-bridge/venv/bin/python3 /opt/sanjana-bridge/bridge.py

# Graceful shutdown: send SIGTERM, wait 60s for in-flight calls, then SIGKILL
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60

# Restart policy: always restart, 5s cooldown, rate-limit to 5 restarts/minute
Restart=always
RestartSec=5

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G
CPUQuota=200%

# Config
Environment=BRIDGE_PORT=8086
Environment=HEALTH_PORT=8087
Environment=GATEWAY_BASE=https://aitest.lintel.in
Environment=RECORD_SILENCE_SEC=1
Environment=RECORD_MAX_SEC=15
Environment=TMP_DIR=/tmp/sanjana
Environment=MAX_CONCURRENT_CALLS=30
Environment=STT_PROVIDER=sarvam
Environment=TTS_PROVIDER=sarvam
Environment=DEEPFILTER_ENABLED=true
# Set your Sarvam API key — get it at https://dashboard.sarvam.ai
Environment=SARVAM_API_KEY=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sanjana-bridge

[Install]
WantedBy=multi-user.target
