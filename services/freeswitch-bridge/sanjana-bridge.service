[Unit]
Description=Sanjana FreeSWITCH AI Bridge
After=freeswitch.service network-online.target
Requires=freeswitch.service

[Service]
User=root
WorkingDirectory=/opt/sanjana-bridge
ExecStart=/opt/sanjana-bridge/venv/bin/python3 /opt/sanjana-bridge/bridge.py
Restart=always
RestartSec=5
Environment=BRIDGE_PORT=8086
Environment=GATEWAY_WS=wss://aitest.lintel.in/ws
Environment=RECORD_SILENCE_SEC=2
Environment=RECORD_MAX_SEC=15
Environment=TMP_DIR=/tmp/sanjana
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
